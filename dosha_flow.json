        {
      "id": "PHONE_NUMBER_SCREEN",
      "title": "Contact Information",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",  
            "children": [
              {
                "type": "TextBody",
                "text": "To begin, please enter your WhatsApp number."
              },
              {
                "type": "Dropdown",
                "name": "COUNTRY_CODE_VAL",
                "label": "Country Code",
                "required": true,
                "data-source": [
                  { "id": "+91", "title": "+91 India" },
                  { "id": "+1", "title": "+1 USA" },
                  { "id": "+44", "title": "+44 UK" },
                  { "id": "+61", "title": "+61 Australia" },
                  { "id": "+971", "title": "+971 UAE" }
                ]
              },
              {
                "type": "TextInput",
                "name": "PHONE_NUMBER_VAL",
                "label": "Phone Number",
                "required": true,
                "input-type": "phone"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "country_code": "${form.COUNTRY_CODE_VAL}",  
                    "mobile_number": "${form.PHONE_NUMBER_VAL}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
