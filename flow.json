  "data_api_version": "3.0",
  "version": "7.3",
  "screens": [
    {
      "id": "PHONE_NUMBER_SCREEN",
      "title": "Contact Information",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextBody",
                "text": "To begin, please enter your WhatsApp number. Don't skip it."
              },
              {
                "type": "Dropdown",
                "name": "COUNTRY_CODE_VAL",
                "label": "Country Code",
                "required": true,
                "data-source": [
                  {
                    "id": "+91",
                    "title": "+91 India"
                  },
                  {
                    "id": "+1",
                    "title": "+1 USA"
                  },
                  {
                    "id": "+44",
                    "title": "+44 UK"
                  },
                  {
                    "id": "+61",
                    "title": "+61 Australia"
                  },
                  {
                    "id": "+971",
                    "title": "+971 UAE"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "PHONE_NUMBER_VAL",
                "label": "Phone Number",
                "required": true,
                "input-type": "phone"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "country_code": "${form.COUNTRY_CODE_VAL}",
                    "mobile_number": "${form.PHONE_NUMBER_VAL}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "FIRST_NAME",
      "title": "First Name",
      "data": {
        "mobile_number": {
          "type": "string",
          "__example__": "15550001234"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextBody",
                "text": "What is your first name?"
              },
              {
                "type": "TextInput",
                "name": "FIRST_NAME_VAL",
                "required": true,
                "label": "First Name"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "first_name": "${form.FIRST_NAME_VAL}",
                    "mobile_number": "${data.mobile_number}"
